FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

# Set non-interactive for apt
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies: build tools, Node.js/npm, and curl (for healthchecks)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    nodejs npm \
    curl && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r appuser && useradd -r -g appuser appuser

WORKDIR /app

# Install Python dependencies using uv
COPY pyproject.toml .
RUN uv lock && uv sync --frozen

# Build Tailwind assets: copy Node dependency files and run npm install
COPY theme/static_src/package.json theme/static_src/package-lock.json ./theme/static_src/
WORKDIR /app/theme/static_src
RUN npm ci --omit=dev

# Return to app root and copy application code
WORKDIR /app
COPY . /app

# Prepare static directories and adjust ownership for non-root user
RUN mkdir -p /app/staticfiles /app/theme/static && \
    chown -R appuser:appuser /app

# Set runtime environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH="/app" \
    DJANGO_SETTINGS_MODULE="app.settings.production" \
    PATH="/usr/local/bin:/app/.venv/bin:$PATH"

# Switch to non-root user
USER appuser

# Expose Gunicorn port
EXPOSE 8000

# Run Gunicorn
CMD ["uv", "run", "gunicorn", "--bind", "0.0.0.0:8000", "--workers", "3", "app.wsgi:application"]
