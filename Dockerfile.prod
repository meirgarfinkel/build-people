# Stage 1: Node.js environment for Tailwind
FROM node:20-bookworm-slim as tailwind-builder
WORKDIR /app
COPY theme/package.json theme/package-lock.json ./theme/
RUN cd theme && npm ci --omit=dev

# Stage 2: Python environment builder
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim as python-builder
WORKDIR /app

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential && \
    rm -rf /var/lib/apt/lists/*

# Copy dependency specs
COPY pyproject.toml ./

# Install with UV cache
RUN --mount=type=cache,target=/app/.cache/uv \
    uv lock && \
    uv sync --frozen && \
    uv pip install --no-deps -e .

# Stage 3: Final production image
FROM python:3.12-slim-bookworm
WORKDIR /app

# Create non-root user and directories
RUN groupadd -r appuser && \
    useradd -r -g appuser appuser && \
    mkdir -p /app/staticfiles /app/theme/static && \
    chown -R appuser:appuser /app

# Copy installed dependencies
COPY --from=python-builder --chown=appuser:appuser /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=python-builder --chown=appuser:appuser /usr/local/bin /usr/local/bin
COPY --from=tailwind-builder --chown=appuser:appuser /app/theme/node_modules ./theme/node_modules

# Copy application code
COPY --chown=appuser:appuser . .

# Runtime configuration
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH="/app" \
    DJANGO_SETTINGS_MODULE="app.settings.production" \
    PATH="/usr/local/bin:$PATH"

# Ensure staticfiles directory exists (for collectstatic)
RUN mkdir -p /app/staticfiles && chown appuser:appuser /app/staticfiles

USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=5s \
    CMD curl -f http://localhost:8000/health/ || exit 1

CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "3", "app.wsgi:application"]
