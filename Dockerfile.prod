# Stage 1: Node.js environment for Tailwind
FROM node:20-bookworm-slim as tailwind-builder
WORKDIR /app
COPY theme/static_src/package.json theme/static_src/package-lock.json ./theme/static_src/
RUN cd theme/static_src && npm ci --omit=dev

# Stage 2: Python environment builder
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim as python-builder
WORKDIR /app

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential && \
    rm -rf /var/lib/apt/lists/*

# Copy dependency specs
COPY pyproject.toml ./

# Install with UV cache (FIXED: removed --no-deps)
RUN --mount=type=cache,target=/app/.cache/uv \
    uv lock && \
    uv sync --frozen && \
    uv pip install -e .

# Stage 3: Final production image
FROM python:3.12-slim-bookworm
WORKDIR /app

# Create non-root user and directories
RUN groupadd -r appuser && \
    useradd -r -g appuser appuser && \
    mkdir -p /app/staticfiles /app/theme/static && \
    chown -R appuser:appuser /app

# Copy installed dependencies (modified copy commands)
COPY --from=python-builder --chown=appuser:appuser /app /app

# Runtime configuration (updated PATH)
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH="/app" \
    DJANGO_SETTINGS_MODULE="app.settings.production" \
    PATH="/usr/local/bin:/app/.venv/bin:$PATH"

# Ensure staticfiles directory exists (for collectstatic)
RUN mkdir -p /app/staticfiles && chown appuser:appuser /app/staticfiles

USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=5s \
    CMD curl -f http://localhost:8000/health/ || exit 1

CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "3", "app.wsgi:application"]
