FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

# Set non-interactive for apt
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg && \
    chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list > /dev/null && \
    apt-get update && apt-get install -y nodejs gh && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN mkdir -p /home && \
    groupadd --gid 1000 appuser && \
    useradd --uid 1000 --gid 1000 --create-home --home-dir /home/appuser --shell /bin/bash appuser

# Set working directory
WORKDIR /app

# Install Python dependencies using uv
COPY pyproject.toml .
RUN uv lock && uv sync --frozen

COPY . /app

# Build Tailwind assets
RUN uv run python manage.py tailwind build

# Collect static files
RUN uv run python manage.py collectstatic --noinput

# Set runtime environment variables
ENV PYTHONUNBUFFERED=1 \
PYTHONPATH="/app" \
DJANGO_SETTINGS_MODULE="app.settings.development" \
PATH="/usr/local/bin:/app/.venv/bin:$PATH"

# Set permissions
RUN chown -R appuser:appuser /app

# Switch to non-root user for security
USER appuser

# Expose Gunicorn port
EXPOSE 8000

# Command to run Gunicorn
CMD ["uv", "run", "gunicorn", "--bind", "0.0.0.0:8000", "--workers", "3", "app.wsgi:application"]
