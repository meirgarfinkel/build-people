FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

# Set non-interactive for apt
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && \
    apt-get install -y git curl && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg && \
    chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list > /dev/null && \
    apt-get update && \
    apt-get install -y nodejs gh && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd --gid 1000 appuser && \
    useradd --uid 1000 --gid 1000 -m -s /bin/bash appuser

# Install Python dependencies using uv
WORKDIR /app
COPY . .
RUN uv lock && uv sync --frozen

# Install Node.js dependencies
WORKDIR /app/theme/static_src
RUN npm install

# Set environment variables
WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
PYTHONPATH="/app" \
DJANGO_SETTINGS_MODULE="app.settings.development" \
PATH="/usr/local/bin:/app/.venv/bin:$PATH"

# Set permissions
RUN chown -R appuser:appuser /app

# Switch to non-root user for security
USER appuser

# Expose Django port
EXPOSE 8000

# Command to run Django server
CMD ["uv", "run", "python", "manage.py", "runserver", "0.0.0.0:8000"]
